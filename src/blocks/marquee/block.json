{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/marquee",
	"version": "1.0.0",
	"title": "Marquee",
	"category": "wolf-blocks",
	"description": "Continuously scrolling text band. Speed, direction and content editable.",
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"attributes": {
		"text": {
			"type": "string",
			"default": "WolfThemes · Premium WordPress Themes · "
		},
		"direction": {
			"type": "string",
			"default": "left",
			"enum": ["left", "right"]
		},
		"animationDuration": {
			"type": "number",
			"default": 30
		},
		"link": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"color": {
			"background": false,
			"text": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"textTransform": true,
			"letterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	}
}
