{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/stats-counter",
	"version": "1.0.0",
	"title": "Stats Counter",
	"category": "wolf-blocks",
	"description": "Animated number counter for displaying key statistics.",
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Sales"
		},
		"startNumber": {
			"type": "number",
			"default": 0
		},
		"endNumber": {
			"type": "number",
			"default": 100
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": ""
		},
		"animationDuration": {
			"type": "number",
			"default": 2000
		},
		"thousandsSeparator": {
			"type": "boolean",
			"default": true
		},
		"separatorStyle": {
			"type": "string",
			"default": "default",
			"enum": ["default", "dots", "space", "underscore", "apostrophe"]
		}
	},
	"supports": {
		"html": false
	}
}
