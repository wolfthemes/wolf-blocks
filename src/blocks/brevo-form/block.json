{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/brevo-form",
	"version": "1.0.0",
	"title": "Brevo Form",
	"category": "wolf-blocks",
	"description": "Email subscription form connected to a Brevo list.",
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"attributes": {
		"listId": {
			"type": "string",
			"default": ""
		},
		"showName": {
			"type": "boolean",
			"default": false
		},
		"buttonLabel": {
			"type": "string",
			"default": "Subscribe"
		},
		"namePlaceholder": {
			"type": "string",
			"default": "Your name"
		},
		"emailPlaceholder": {
			"type": "string",
			"default": "Your email"
		},
		"emptyEmailMessage": {
			"type": "string",
			"default": "Please enter your email address."
		},
		"invalidEmailMessage": {
			"type": "string",
			"default": "Please enter a valid email address."
		},
		"emptyNameMessage": {
			"type": "string",
			"default": "Please enter your name."
		},
		"successMessage": {
			"type": "string",
			"default": "Thanks for subscribing!"
		},
		"errorMessage": {
			"type": "string",
			"default": "Something went wrong. Please try again."
		}
	},
	"supports": {
		"html": false
	}
}
