{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/pricing-table",
	"version": "1.0.0",
	"title": "Pricing Table",
	"category": "wolf-blocks",
	"description": "Pricing tiers with features list and call-to-action.",
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"attributes": {
		"tagline": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"htmlTag": {
			"type": "string",
			"default": "h3",
			"enum": ["h2", "h3", "h4", "h5", "h6"]
		},
		"price": {
			"type": "number",
			"default": 0
		},
		"currency": {
			"type": "string",
			"default": "$"
		},
		"currencyPosition": {
			"type": "string",
			"default": "before",
			"enum": ["before", "after"]
		},
		"offerPrice": {
			"type": "number",
			"default": 0
		},
		"pricePeriod": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": "Get Started"
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryButtonText": {
			"type": "string",
			"default": ""
		},
		"secondaryButtonUrl": {
			"type": "string",
			"default": ""
		},
		"featured": {
			"type": "boolean",
			"default": false
		},
		"featuredText": {
			"type": "string",
			"default": "Popular"
		},
		"services": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		}
	},
	"supports": {
		"html": false
	}
}
