{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/countdown",
	"version": "1.0.0",
	"title": "Countdown",
	"category": "wolf-blocks",
	"description": "Countdown timer to a target date, with optional Wolf Store offer integration.",
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"attributes": {
		"source": {
			"type": "string",
			"default": "manual",
			"enum": ["manual", "wolf-store-offer"]
		},
		"targetDate": {
			"type": "string",
			"default": ""
		},
		"expiredText": {
			"type": "string",
			"default": "Offer has ended"
		},
		"showDays": {
			"type": "boolean",
			"default": true
		},
		"showSeconds": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": true,
			"fontWeight": true,
			"fontStyle": true,
			"letterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	}
}
