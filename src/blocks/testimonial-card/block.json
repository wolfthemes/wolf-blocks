{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/testimonial-card",
	"version": "1.0.0",
	"title": "Testimonial Card",
	"category": "wolf-blocks",
	"description": "Quote and author card for customer testimonials.",
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"attributes": {
		"content": {
			"type": "string",
			"default": ""
		},
		"avatarUrl": {
			"type": "string",
			"default": ""
		},
		"avatarId": {
			"type": "number",
			"default": 0
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"authorTitle": {
			"type": "string",
			"default": ""
		},
		"link": {
			"type": "string",
			"default": ""
		},
		"imagePosition": {
			"type": "string",
			"default": "left",
			"enum": ["left", "top"]
		},
		"textAlign": {
			"type": "string",
			"default": "left",
			"enum": ["left", "center", "right"]
		}
	},
	"supports": {
		"html": false
	}
}
