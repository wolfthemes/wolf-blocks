{
	"name": "wolf-blocks",
	"version": "1.0.0",
	"description": "Reusable Gutenberg blocks for WolfThemes",
	"author": "Constantin Saguin",
	"license": "ISC",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js --max-warnings=0",
		"lint:css": "stylelint \"**/*.scss\" --max-warnings=0",
		"lint:php": "composer run lint:php",
		"format:js": "wp-scripts format",
		"format:css": "stylelint \"**/*.scss\" --fix",
		"format:php": "composer run format:php",
		"packages-update": "wp-scripts packages-update"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^22.0.0",
		"@wordpress/icons": "^14.0.1",
		"@wordpress/prettier-config": "^4.30.0",
		"@wordpress/scripts": "^24.6.0",
		"@wordpress/stylelint-config": "^19.1.0",
		"copy-webpack-plugin": "^11.0.0",
		"stylelint": "^13.13.1"
	}
}
