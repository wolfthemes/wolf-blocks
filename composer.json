{
	"name": "wolfthemes/wolf-blocks",
	"description": "Reusable Gutenberg blocks for WolfThemes",
	"type": "wordpress-plugin",
	"homepage": "https://wolfthemes.com",
	"authors": [
		{
			"name": "Constantin Saguin",
			"email": "contact@wolfthemes.com",
			"homepage": "https://wolfthemes.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"autoload": {
		"psr-4": {
			"Wolf_Blocks\\": "Functions/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
		"automattic/vipwpcs": "^3.0"
	},
	"scripts": {
		"lint:php": "./vendor/bin/phpcs --standard=phpcs.xml.dist",
		"format:php": "./vendor/bin/phpcbf --standard=phpcs.xml.dist || true"
	}
}
